# Docker Runtime Overrides
# These values are container-oriented defaults and usually pair with
# `docker-compose.yml` / `docker/entrypoint.sh`, not plain local runs.

# Service discovery inside the Docker network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# Container web process settings.
# `APP_HOST` is injected into `src.run_app` by the Docker entrypoint.
APP_HOST=0.0.0.0
CONTAINER_APP_PORT=8000

# Proxy trust for containerized deployments. The entrypoint maps this to the
# runtime-only `FORWARDED_ALLOW_IPS` env var when starting `src.run_app`.
TRUSTED_PROXY_IPS=*
