# PostgreSQL
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5430

# Redis
REDIS_HOST=localhost
REDIS_PORT=6370
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Web App Ports
# `APP_PORT` is the local bind port used by `python -m src.run_app`.
# `CONTAINER_APP_PORT` is the internal port exposed inside the Docker container.
CONTAINER_APP_PORT=8000
APP_PORT=8001

# Core Application Settings
UI_SESSION_SECRET_KEY=change_me_to_a_long_random_string
UI_SESSION_COOKIE_NAME=habitflow_session
UI_SESSION_MAX_AGE=1209600
UI_SESSION_SAME_SITE=lax
# Set to True only behind real HTTPS in production.
UI_SESSION_HTTPS_ONLY=False

AUTH_SESSION_COOKIE_NAME=auth_session
AUTH_SESSION_MAX_AGE=1209600
AUTH_SESSION_SAME_SITE=lax
# Set to True only behind real HTTPS in production.
AUTH_SESSION_HTTPS_ONLY=False

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/auth/google/callback

ZENQUOTES_API_URL=https://zenquotes.io/api/quotes
REFILL_INTERVAL_HOURS=1

DEBUG=True

# Logging
# Optional; standard names DEBUG, INFO, WARNING, ERROR, CRITICAL.
# If unset, uses DEBUG when DEBUG=True else INFO.
LOG_LEVEL=WARNING
LOG_FORMAT=text
REQUEST_ID_HEADER=X-Request-ID
# Controls SQLAlchemy engine logger verbosity independently from DEBUG.
SQL_LOG_LEVEL=WARNING

# Optional Runtime Overrides For `src.run_app`
# These are supported, but they are process/deployment knobs rather than the
# main application config surface. Most local runs do not need them, and Docker
# sets the proxy-related ones at runtime in the entrypoint.
#
# APP_HOST=127.0.0.1
# UVICORN_RELOAD=false
# PROXY_HEADERS=false
# FORWARDED_ALLOW_IPS=127.0.0.1
# TRUSTED_PROXY_IPS=127.0.0.1
#
# Notes:
# - Use `UVICORN_RELOAD=true` for direct local runs if you specifically want
#   uvicorn reload behavior from `src.run_app`.
# - Use `PROXY_HEADERS` and `FORWARDED_ALLOW_IPS` only when the app is behind a
#   trusted reverse proxy.
# - `TRUSTED_PROXY_IPS` remains supported as a compatibility alias.

# Select another dotenv file from the shell before running make/compose:
# ENV_FILE=.env.dev make run
# ENV_FILE=.env.test make test
